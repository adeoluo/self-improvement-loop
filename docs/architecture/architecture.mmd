flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    CLI(["CLI<br/>train | evaluate | solve | serve"]):::edge
    Client(["HTTP client"]):::edge

    subgraph Task["Task and config (seeded, verifiable)"]
        direction TB
        Trainer["SelfTrainer config<br/>iterations, k samples, seed"]:::control
        Env["Puzzle environment<br/>8 actions, step budget"]:::core
        Oracle["BFS oracle<br/>shortest solution"]:::core
        Splits[("Oracle-filtered splits<br/>200 train, 120 test puzzles")]:::data
    end

    subgraph Loop["Self-improvement loop (per iteration)"]
        direction TB
        Sample["Sampled rollouts<br/>k per puzzle at temperature"]:::core
        Verify{{"Verifier filter<br/>keep shortest solved trace"}}:::control
        Rationalize["Rationalization<br/>oracle-hinted rollout when no sample solves"]:::core
        Clone["Behavior cloning<br/>exact softmax gradient"]:::core
        Policy[("Log-linear policy<br/>weights over state-action features")]:::data
    end

    subgraph Serve["Interfaces (stdlib HTTP, trained at startup)"]
        direction TB
        Router["Router<br/>/health | /ready | /evaluate | /history | /solve"]:::core
        Validate["Validation<br/>integer start, target, budget up to 12"]:::control
        Greedy["Greedy decode<br/>actions + verified flag"]:::core
    end

    subgraph Eval["Evaluation and observability"]
        direction TB
        Evaluate["Held-out evaluation<br/>greedy accuracy, pass@k, length overhead"]:::obs
        History["Iteration history<br/>accuracy, sampled vs hinted, NLL"]:::obs
        Metrics["Route metrics<br/>Prometheus GET /metrics"]:::obs
    end

    CLI -->|train, evaluate, solve| Trainer
    Trainer -->|each iteration| Sample
    Splits -->|train puzzles| Sample
    Splits -->|unsolved puzzles| Rationalize
    Oracle -.->|hint| Rationalize
    Policy -.->|current policy| Sample
    Sample -->|traces| Verify
    Env -.->|exact check| Verify
    Verify -->|solved traces| Clone
    Rationalize -->|recovered traces| Clone
    Clone -->|updated weights| Policy
    Policy -->|greedy rollouts| Evaluate
    Splits -.->|test puzzles| Evaluate
    Trainer -.->|per-iteration reports| History
    Client -->|JSON request| Router
    Router -->|POST /solve| Validate
    Validate -->|puzzle| Greedy
    Policy -.->|trained weights| Greedy
    Router -->|GET /evaluate| Evaluate
    Router -->|GET /history| History
    Router -.-> Metrics
