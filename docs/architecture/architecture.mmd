flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces"]
        direction TB
        CLI["CLI<br/>train, evaluate, solve"]:::edge
        Client(["HTTP client"]):::edge
        Router["HTTP router<br/>/solve /history"]:::core
        Validate["Validation<br/>start, target, budget"]:::control
        CLI ~~~ Client --> Router --> Validate
    end

    subgraph Task["Task and data (seeded)"]
        direction TB
        Env["Puzzle environment<br/>8 actions, budget"]:::core
        Oracle["BFS oracle<br/>shortest solution"]:::core
        Splits[("Disjoint splits<br/>200 train, 120 test")]:::data
        Env ~~~ Oracle --> Splits
    end

    subgraph Loop["Self-improvement loop"]
        direction TB
        Sample["Sampled rollouts<br/>k per puzzle"]:::core
        Verify{{"Verifier<br/>keep shortest solved"}}:::control
        Rationalize["Rationalization<br/>oracle-hinted trace"]:::core
        Clone["Behavior cloning<br/>exact softmax gradient"]:::core
        Policy[("Log-linear policy")]:::data
        Sample --> Verify --> Clone --> Policy
        Verify -->|unsolved| Rationalize --> Clone
    end

    subgraph Obs["Evaluation and observability"]
        direction TB
        Evaluate["Held-out evaluation<br/>greedy accuracy, pass@k"]:::obs
        History["Iteration history<br/>accuracy per iteration"]:::obs
        Solve["Solve response<br/>greedy, verified"]:::obs
        Metrics["Route metrics<br/>Prometheus text"]:::obs
        Evaluate --> History
        History ~~~ Solve ~~~ Metrics
    end

    Interfaces -->|train, solve| Loop
    Task -->|puzzles, hints| Loop
    Loop -->|trained policy| Obs
